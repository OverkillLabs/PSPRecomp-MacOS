<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>com.pspreco.vcsnative</string>
    <key>CFBundleName</key>
    <string>VCSNative</string>
    <key>CFBundleDisplayName</key>
    <string>VCSNative</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>VCSNative</string>
    <key>CFBundleVersion</key>
    <string>1.0</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <!-- Declaring a game category is what lets macOS Sonoma+ offer Game Mode
         for this process (elevated CPU/GPU scheduling priority, reduced
         Bluetooth input latency, background-task throttling) while it runs
         fullscreen -- without this it is invisible to Game Mode even though
         the game is exactly the kind of fullscreen, latency-sensitive,
         CPU/GPU-hungry workload Game Mode exists for. Embedded directly into
         the executable's __TEXT,__info_plist section (see CMakeLists.txt)
         rather than wrapping this in a full .app bundle, since PSP_DATA and
         every other asset this binary loads are resolved relative to its own
         path and a bundle would move that path under Contents/MacOS/. -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.games</string>
    <key>LSMinimumSystemVersion</key>
    <string>10.13</string>
    <key>NSHighResolutionCapable</key>
    <true/>
</dict>
</plist>
